# Copy this file to .env and fill it in. Never commit .env.

# WhatsApp > Settings > Agents > Create an agent, then open the agent's chat > Chat info > API key
WHATSAPP_AGENT_API_KEY=

# Which LLM answers: claude or openai.
# Leave empty to use whichever key below is set (Claude first if both are).
LLM_PROVIDER=

# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Notion MCP server (only used with --mcp). Make the integration READ-ONLY: see docs/mcp.md.
# https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Optional, used by both LLMs
# SYSTEM_PROMPT=You are my personal assistant...
